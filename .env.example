# ── Required Bot & AI Credentials ───────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ── Optional: Web Dashboard & Discord OAuth2 ─────────────────────────────────
PORT=8080
JWT_SECRET=super-secret-key-change-me-in-production
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
DISABLE_API=false

# ── Optional: Database Configuration ─────────────────────────────────────────
# PostgreSQL Database URL (falls back to local SQLite bot_data.db if not provided)
DATABASE_URL=postgresql://user:pass@host:port/dbname

# ── Optional: Sports & Esports Free API Keys ─────────────────────────────────
# Free key from: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here
# Free key from: https://pandascore.co
PANDASCORE_API_KEY=your_pandascore_api_key_here

# ── Optional: Keep-alive & Cloud Hosting Integration ──────────────────────────
UPTIME_API_KEY=your_uptimerobot_api_key_here
RENDER_EXTERNAL_URL=your_render_external_url_here
RENDER_SERVICE_NAME=your_render_service_name_here
